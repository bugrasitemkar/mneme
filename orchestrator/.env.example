# Anthropic API key — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Langfuse — cloud.langfuse.com → your project → Settings → API Keys
# Leave blank to disable observability (Mneme will still run without it)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# GitHub sync — github.com → Settings → Developer settings → Personal access tokens → Fine-grained
# Token needs: Contents (read & write) on the mneme-self-discovery repo only
# Leave blank to disable GitHub sync
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=bugrasitemkar/mneme-self-discovery
